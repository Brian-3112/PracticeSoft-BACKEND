
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//creacion de la tabla o modelo usuario
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

// Tabla Vehiculo
model Vehiculo {
  id             Int      @id @default(autoincrement())
  nombreVehiculo String
  placa          String   @unique  
  transito       String
  fechaSOAT      DateTime @db.Date   // Solo guarda fecha (YYYY-MM-DD)
  fechaTecno     DateTime @db.Date   // Solo guarda fecha (YYYY-MM-DD)
  description    String

  // Relación inversa hacia Renta
  rentas Renta[]
}

// Tabla Cliente
model Cliente {
  id                 Int    @id @default(autoincrement())
  nombre             String
  identificacion     String @unique
  direccion          String
  celular            String
  correo             String
  nombreFamiliar     String
  direccionFamiliar  String
  telefonoFamiliar   String
  nombrePersonal     String
  direccionPersonal  String
  telefonoPersonal   String

  // Relación inversa hacia Renta
  rentas Renta[]
}

// Tabla Renta
model Renta {
  id              Int       @id @default(autoincrement())
  vehiculoId      Int
  clienteId       Int
  fechaEntrega    DateTime
  horaEntrega     String
  fechaDevolucion DateTime
  horaDevolucion  String
  numeroDias      Int
  valorDia        Float
  valorTotal      Float
  createdAt       DateTime  @default(now())

  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
}