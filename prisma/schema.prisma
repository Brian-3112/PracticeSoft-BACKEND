
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//creacion de la tabla o modelo usuario
model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Vehiculo {
  id             Int    @id @default(autoincrement())
  nombreVehiculo String
  placa          String @unique  
  transito       String
}

