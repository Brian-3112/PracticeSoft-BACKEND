generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//creacion de la tabla o modelo usuario
model User {
  id       Int     @id @default(autoincrement())
  nombre   String?
  apellido String?
  email    String  @unique
  password String
}

// Tabla Vehiculo
model Vehiculo {
  id             Int      @id @default(autoincrement())
  nombreVehiculo String
  placa          String   @unique
  transito       String
  fechaSOAT      DateTime @db.Date // Solo guarda fecha (YYYY-MM-DD)
  fechaTecno     DateTime @db.Date // Solo guarda fecha (YYYY-MM-DD)
  description    String

  // Relación inversa hacia Renta
  rentas Renta[]
}

// Tabla Cliente
model Cliente {
  id                Int    @id @default(autoincrement())
  nombre            String
  identificacion    String @unique
  direccion         String
  celular           String
  correo            String
  nombreFamiliar    String
  direccionFamiliar String
  telefonoFamiliar  String
  nombrePersonal    String
  direccionPersonal String
  telefonoPersonal  String

  // Relación inversa hacia Renta
  rentas Renta[]
}

// Tabla Renta
model Renta {
  id                 Int      @id @default(autoincrement())
  vehiculoId         Int
  clienteId          Int
  fechaEntrega       DateTime @db.Date // Solo guarda fecha (YYYY-MM-DD)
  horaEntrega        String
  fechaDevolucion    DateTime @db.Date // Solo guarda fecha (YYYY-MM-DD)
  horaDevolucion     String
  numeroDias         Int
  diasCobrados       Int      @default(0)
  valorDia           Float
  valorTotal         Float
  cobroDiaCalendario Boolean  @default(false)
  tipoCalculoRenta   String   @default("periodo_24_horas")
  createdAt          DateTime @default(now())

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  cliente  Cliente  @relation(fields: [clienteId], references: [id])
}

// Tabla Documentacion
model Documentacion {
  id              Int      @id @default(autoincrement())
  nombreCliente   String
  cedula          String
  fechaContrato   DateTime @db.Date
  archivoNombre   String
  archivoMimeType String
  archivoPath     String
  archivoSize     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
